{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ECC_HOOK_PROFILE": "minimal",
    "ECC_GATEGUARD": "off",
    "ECC_SESSION_START_CONTEXT": "off"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx supabase migration *)",
      "Bash(npx supabase gen *)",
      "Bash(npx supabase status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git worktree *)",
      "Bash(git merge *)",
      "Bash(vercel deploy*)",
      "Bash(vercel env ls*)",
      "Bash(vercel logs *)",
      "Bash(curl -s http://localhost*)",
      "Bash(date*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npx supabase db reset --linked*)",
      "Bash(supabase db reset --linked*)",
      "Bash(vercel remove*)",
      "Bash(vercel project rm*)"
    ],
    "ask": [
      "Bash(npx supabase db push*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel env add *)",
      "Bash(git push*)"
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "exa@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true
  },
  "agent": "hackathon:orchestrator",
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/skills/hackathon/bin/hack\" statusline"
  }
}
