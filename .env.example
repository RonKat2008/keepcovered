# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic (https://console.anthropic.com/settings/keys) - server-only, never prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-sonnet-5-5)
# ANTHROPIC_MODEL=

# Demo insurance: "true" serves canned AI replies + seeded data (src/lib/demo.ts)
DEMO_MODE=false
