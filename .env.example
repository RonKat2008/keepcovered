# Claude, first-party API (needed for Batches evals, Files API, and the portal agent's browser toolset)
ANTHROPIC_API_KEY=
# Claude via Microsoft Foundry (runtime path when set)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# Voyage AI embeddings
VOYAGE_API_KEY=
# Capital One Nessie (falls back to a mock bank when unset)
NESSIE_API_KEY=
# Convex (falls back to the in-memory store with a 1h TTL when unset)
CONVEX_URL=
# Azure Application Insights (OpenTelemetry export)
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Demo insurance: "true" serves recorded Claude outputs from fixtures/
DEMO_MODE=false
